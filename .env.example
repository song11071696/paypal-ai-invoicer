# --- PayPal (sandbox). Leave empty to run in offline mock mode. ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # default
# PAYPAL_MODE=mock                                  # force mock even if keys are set
# BRAND_NAME=Maya's Ceramics                         # shown on PayPal checkout / invoice
# PUBLIC_URL=http://localhost:8000                   # used for the Orders return/cancel URLs

# --- AI engine. Default "rules" needs no key. ---
# LLM_PROVIDER=openai        # openai | openrouter | ollama  (any OpenAI-compatible endpoint)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# LEDGER_PATH=data/ledger.json   # where the web app keeps its local ledger
